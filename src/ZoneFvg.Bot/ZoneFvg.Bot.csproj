<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ZoneFvg.Bot</RootNamespace>
    <AssemblyName>ZoneFvgBot</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoneFvg.Core\ZoneFvg.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- News history for backtests, read by ZoneFvgBot and passed to the core as text (spec 6.4). -->
    <EmbeddedResource Include="News\news-history.csv" LogicalName="ZoneFvg.Bot.news-history.csv" />
  </ItemGroup>

</Project>
