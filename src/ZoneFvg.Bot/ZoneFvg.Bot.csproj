<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ZoneFvg.Bot</RootNamespace>
    <AssemblyName>ZoneFvgBot</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoneFvg.Core\ZoneFvg.Core.csproj" />
  </ItemGroup>

  <!-- TEMPORARY (WP08): prints the member list of the cTrader.Automate package's XML documentation
       to the CI log, so the adapter can be checked against the exact package version. Removed
       before the work package is finished. -->
  <Target Name="Wp08DumpApi" AfterTargets="Build">
    <Exec Command="python3 Wp08ApiDump.py &quot;$(NuGetPackageRoot)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreStandardErrorWarningFormat="true" />
  </Target>

</Project>
