<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- Core and Bot target net8.0, the version cTrader CLI requires (owner decision 2026-11-16). -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Package advisories are reported but do not break the build; Dependabot handles them. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
